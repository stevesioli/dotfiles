#!/bin/zsh
#
# ---------------------------------------------------------------------------
#
# Description: This file holds all my BASH configurations
#
# Sections:
# 1. Environment Configuration
# 2. Activate Additional Files
# ---------------------------------------------------------------------------

# 	-------------------------------
# 	1. ENVIRONMENT CONFIGURATION
# 	-------------------------------

    #	Setup path variables
# 	------------------------------------------------------------

    export PATH=$HOME/bin:/opt/homebrew/bin:/opt/homebrew:$HOME/.jenv/bin:$MK/cmd:$PATH
    export NVM_DIR="$HOME/.nvm"
      [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
      # [ -s "/opt/homebrew/opt/nvm/etc/bash_completion" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion"  # This loads nvm bash_completion

    eval "$(jenv init -)"

# 	Set terminal colors
# 	------------------------------------------------------------

    export CLICOLOR=1
    export LSCOLORS=GxFxCxDxBxegedabagaced
    export PS1='
(%*) %F{cyan}%~%f
%F{yellow}%n%f%F{green}@%m%f %# '

    PS1=$PS1

#   pyenv
#   ------------------------------------------------------------

    [ -s "/opt/homebrew/bin/pyenv" ] && export PATH=$HOME/.pyenv/shims:$PATH

    eval "$(pyenv init --path)"

# 	zsh git completion
# 	------------------------------------------------------------

    if type brew &>/dev/null; then
     FPATH=$(brew --prefix)/share/zsh-completions:$FPATH

     autoload -Uz compinit
     compinit
    fi

    if [ -f "/opt/homebrew/opt/zsh-git-prompt/zshrc.sh" ]; then
        source "/opt/homebrew/opt/zsh-git-prompt/zshrc.sh"

        ZSH_THEME_GIT_PROMPT_PREFIX=' ['
        ZSH_THEME_GIT_PROMPT_SUFFIX=']'

        export GIT_PROMPT='
(%*) %F{cyan}%~%f
%F{yellow}%n%f%F{green}@%m%f$(git_super_status) %# '

        PS1=$GIT_PROMPT
    fi

# 	-------------------------------
# 	2. ACTIVATE ADDITIONAL FILES
# 	-------------------------------

    if [ -d "$HOME/.dotfiles" ]
    then
        . ~/.dotfiles/aliases
        . ~/.dotfiles/aliases.MACOS
        . ~/.dotfiles/functions
    fi

# 	-------------------------------
# 	3. HISTORY KEY BINDINGS
# 	-------------------------------

    autoload -U up-line-or-beginning-search
    autoload -U down-line-or-beginning-search
    zle -N up-line-or-beginning-search
    zle -N down-line-or-beginning-search
    bindkey "^[[A" up-line-or-beginning-search # Up
    bindkey "^[[B" down-line-or-beginning-search # Down

# 	-------------------------------
#   4. JAVA CONFIGURATION
#   -------------------------------

    export JAVA_TOOLS_OPTIONS="-DLog4j2.formatMsgNoLookups=true"
